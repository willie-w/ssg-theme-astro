---
import { cn } from '../utils/cn';
import PrimaryButton from './ui/PrimaryButton.astro';
import ReviewCard from './ReviewCard.astro';

type TestimonialsData = {
  author: { handle: string; imageUrl: string | null | undefined; name: string };
  rating: { maxStars: number; rating: number };
  body: string;
};
const { section } = Astro.props;
const items: TestimonialsData[] = section?.items || [];
const mobileSlides: TestimonialsData[] = items.length > 1 ? [...items, items[0]] : items;
---

<section
  id={section?.id || ''}
  class={cn(
    section?.noMarginTop
      ? (section?.noMarginTopMobileOnly ? 'pt-0 sm:pt-16 md:pt-24' : 'pt-0')
      : 'pt-16 sm:pt-24 md:pt-32'
  )}
>
  <div style={'background-color:' + section?.bgColor}>
    <div class='mx-auto max-w-7xl px-2 lg:px-8'>
      <div class='mx-auto max-w-2xl'>
        <h2 class='text-3xl font-bold text-gray-900 sm:text-4xl text-center'>
          {
            section?.title?.map((line: string, index: number) => (
              <Fragment key={index}>
                <span class='block leading-16'>{line}</span>
              </Fragment>
            ))
          }
        </h2>

        {
          section?.description?.map((info: string, index: number) => (
            <Fragment key={index}>
              <p class='mt-4 text-lg leading-8 text-gray-600 text-center'>
                {info}
              </p>
            </Fragment>
          ))
        }
      </div>

      {
        section?.mobileAutoSlide ? (
          <>
            <div class='hidden md:grid mx-auto max-w-7xl px-2 lg:px-8 gap-6 md:grid-cols-3 items-start'>
              {
                items.map((testimonial: TestimonialsData) => (
                  <Fragment key={testimonial?.body}>
                    <div class={cn('pt-8', section?.classes?.body)}>
                      <ReviewCard testimonial={testimonial} />
                    </div>
                  </Fragment>
                ))
              }
            </div>

            <div class='md:hidden overflow-hidden' data-review-slider>
              <div class='flex' data-review-slider-track style='transition: transform 500ms ease;'>
                {
                  mobileSlides.map((testimonial: TestimonialsData, index: number) => (
                    <Fragment key={index}>
                      <div class='w-full shrink-0 px-1'>
                        <div class={cn('pt-8', section?.classes?.body)}>
                          <ReviewCard testimonial={testimonial} />
                        </div>
                      </div>
                    </Fragment>
                  ))
                }
              </div>
            </div>
          </>
        ) : (
          <div class='mx-auto max-w-7xl px-2 lg:px-8 grid gap-6 md:grid-cols-3 items-start'>
            {
              items.map((testimonial: TestimonialsData) => (
                <Fragment key={testimonial?.body}>
                  <div class={cn('pt-8', section?.classes?.body)}>
                    <ReviewCard testimonial={testimonial} />
                  </div>
                </Fragment>
              ))
            }
          </div>
        )
      }
    </div>
  </div>
  <div class='text-center mt-6'>
    <PrimaryButton text={section?.buttonText || ''} href={section?.href}>
      <svg slot='icon' class='size-5 shrink-0' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'>
        <path fill='#4285F4' d='M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.47c-.29 1.48-1.14 2.73-2.4 3.58v2.98h3.86c2.26-2.09 3.56-5.17 3.56-8.8z' />
        <path fill='#34A853' d='M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-2.98c-1.07.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96H1.29v3.09C3.26 21.3 7.31 24 12 24z' />
        <path fill='#FBBC05' d='M5.27 14.31A7.19 7.19 0 0 1 4.9 12c0-.8.14-1.58.37-2.31V6.6H1.29A11.94 11.94 0 0 0 0 12c0 1.92.46 3.74 1.29 5.4z' />
        <path fill='#EA4335' d='M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.7 1.29 6.6l3.98 3.09c.95-2.85 3.6-4.94 6.73-4.94z' />
      </svg>
    </PrimaryButton>
  </div>
  <div></div>
</section>

<script>
  document.querySelectorAll('.review-body').forEach(el => {
    el.addEventListener('click', (e) => {
      (e.currentTarget as HTMLElement).classList.toggle('line-clamp-4');
    });
  });
</script>

<script>
  document.querySelectorAll<HTMLElement>('[data-review-slider]').forEach((el) => {
    const track = el.querySelector<HTMLElement>('[data-review-slider-track]');
    if (!track) return;
    const slideCount = track.children.length;
    const realCount = slideCount > 1 ? slideCount - 1 : slideCount;
    if (realCount < 2) return;

    let index = 0;
    const goTo = (i: number, animate = true) => {
      track.style.transition = animate ? 'transform 500ms ease' : 'none';
      track.style.transform = `translateX(-${i * 100}%)`;
    };

    setInterval(() => {
      index++;
      goTo(index);
      if (index === realCount) {
        track.addEventListener(
          'transitionend',
          function handler() {
            track.removeEventListener('transitionend', handler);
            index = 0;
            goTo(0, false);
          },
          { once: true }
        );
      }
    }, 4000);
  });
</script>
